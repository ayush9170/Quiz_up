generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  name          String?
  email         String?          @unique
  emailVerified DateTime?
  image         String?
  
  accounts      Account[]
  sessions      Session[]
  
  quizzes       Quiz[]           @relation("UserQuizzes")
  responses     UserResponse[]   @relation("UserResponses")

  createdAt     DateTime         @default(now())
}

model Account {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  userId            String   @db.ObjectId
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  sessionToken String   @unique
  userId       String   @db.ObjectId
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Quiz {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  questions   Question[]
  createdBy   User?            @relation("UserQuizzes", fields: [createdById], references: [id])
  createdById String?          @db.ObjectId
  responses   UserResponse[]   @relation("QuizResponses")
  createdAt   DateTime         @default(now())
}

model Question {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  text      String
  options   String[]
  answer    String
  quiz      Quiz?    @relation(fields: [quizId], references: [id])
  quizId    String?  @db.ObjectId
}

model UserResponse {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  user        User     @relation("UserResponses", fields: [userId], references: [id])
  userId      String   @db.ObjectId
  quiz        Quiz     @relation("QuizResponses", fields: [quizId], references: [id])
  quizId      String   @db.ObjectId
  responses   Json
  score       Int
  createdAt   DateTime @default(now())
}
